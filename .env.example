# ─────────────────────────────────────────────────────────────
#  حدیث عشق — نمونه پیکربندی
#  این فایل را با نام  .env  کپی کنید و مقادیر واقعی را وارد کنید.
#  فایل  .env  هرگز نباید در جایی منتشر یا به اشتراک گذاشته شود.
# ─────────────────────────────────────────────────────────────

# ── تلگرام ───────────────────────────────────────────────────
# توکن ربات از @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# آیدی عددی ادمین‌ها — با ویرگول انگلیسی جدا شود
ADMIN_IDS=1251931832,7334828789

# کانالی که کاربر باید عضو آن باشد.
# ربات باید در این کانال «ادمین» باشد وگرنه بررسی عضویت کار نمی‌کند.
# شناسه کانال همیشه با -100 آغاز می‌شود.
CHANNEL_ID=-1002777571203
CHANNEL_USERNAME=hadiseshg3133
CHANNEL_URL=https://t.me/hadiseshg3133

# گروه دریافت مداحی‌های ارسالی کاربران (برای تأیید ادمین)
MADAHI_GROUP_ID=-1003256981248

# گروه نقد و انتقادات
FEEDBACK_GROUP_ID=-1003291586479

# گروه «نسخهٔ آراسته و بایگانی‌شده» — هر نوایی که برچسب و جلد
# می‌خورد، نسخهٔ پایانی‌اش اینجا بایگانی می‌شود.
# این یک گروه ساده است، پس شناسه‌اش با -100 آغاز نمی‌شود.
# اگر تهی بگذارید، به همان گروه مداحی می‌رود.
ORNATE_GROUP_ID=-5307790189

# گروه گزارش کاربران — هر کسی که استارت زد و عضویتش تأیید شد،
# نام و نام‌کاربری و شناسه‌اش اینجا گزارش می‌شود.
# گروه ساده است، پس شناسه‌اش با -100 آغاز نمی‌شود.
# اگر تهی بگذارید، هیچ گزارشی فرستاده نمی‌شود.
USERS_GROUP_ID=-5402797908

# کانال مخزن — هر پست تازهٔ آن خودکار در آرشیو نمایه می‌شود.
# اگر همان کانال اصلی است، همان شناسه را بگذارید.
ARCHIVE_CHANNEL_ID=-1002777571203

# ── اینستاگرام ───────────────────────────────────────────────
INSTAGRAM_PAGE=hadiseshgh3133
INSTAGRAM_URL=https://instagram.com/hadiseshgh3133

# اینستاگرام فرو گرفتن خودکار را می‌بندد. برای پایداری بیشتر
# می‌توانید کوکی یک اکانت را در پرونده‌ای به شکل Netscape بگذارید
# (با افزونهٔ «Get cookies.txt» در مرورگر).
#
# هشدار: آن اکانت ممکن است محدود شود؛ اکانت اصلی خود را به کار
# نبرید. تهی گذاشتنش هم رواست — بسیاری از نوشته‌های همگانی بی
# کوکی هم فرو گرفته می‌شوند.
INSTAGRAM_COOKIES_FILE=

# ── سرور محلی Bot API (اختیاری ولی توصیه‌شده) ────────────────
# بدون آن، سقف دریافت فایل ۲۰ مگابایت و ارسال ۵۰ مگابایت است.
# اگر سرور محلی راه انداختید، نشانی آن را اینجا بگذارید.
LOCAL_BOT_API_URL=

# ── اقتصاد توکن ──────────────────────────────────────────────
INITIAL_TOKENS=3
TOKEN_COST_PER_SEARCH=1
TOKEN_REWARD_PER_APPROVED=1

# ── تنظیمات اجرا ─────────────────────────────────────────────
# مسیر پایگاه داده
DATABASE_PATH=data/hadis.db

# سطح گزارش‌برداری: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# بیشترین پردازش صوتی هم‌زمان (بقیه در صف می‌مانند)
MAX_CONCURRENT_JOBS=3

# مهلت قفل پاسخگویی ادمین، به ثانیه
ADMIN_REPLY_LOCK_TIMEOUT=600

# فاصله میان پیام‌ها هنگام همگانی‌رسانی، به ثانیه
BROADCAST_DELAY=0.05

# ── لایهٔ متن: رونویسی محلی ──────────────────────────────────
# آنچه در نوا خوانده می‌شود به نوشتار درمی‌آید تا «همان نوحه در
# اجرای دیگر» هم یافته شود. کاملاً آفلاین؛ هیچ API بیرونی.
#
# اگر faster-whisper نصب نباشد، این لایه خاموش می‌ماند و چیزی
# نمی‌شکند — ربات همان‌قدر کار می‌کند که پیش از آن می‌کرد.
#
# اندازهٔ مدل: tiny | base | small | medium | large-v3
#   small  — پیش‌فرض. حدود ۵۰۰ مگابایت، روی CPU پذیرفتنی.
#   medium — برای فارسی به‌روشنی دقیق‌تر، ولی نزدیک سه برابر
#            کندتر و حدود ۱٫۵ گیگابایت. اگر سرور جا و توان دارد،
#            ارزشش را دارد.
WHISPER_MODEL=small

# cpu | cuda — روی سرور بی کارت گرافیک، همان cpu.
WHISPER_DEVICE=cpu

# int8 | int8_float16 | float16 | float32
# روی CPU همان int8 درست است؛ float16 تنها روی cuda معنا دارد.
WHISPER_COMPUTE=int8

# ── شبکه ────────────────────────────────────────────────────
# اگر پیوند مستقیم به تلگرام برقرار نیست، نشانی پروکسی را اینجا
# بگذارید. هر سه گونه پذیرفته است:
#   socks5://127.0.0.1:1080
#   http://127.0.0.1:8080
#   socks5://user:pass@host:port
PROXY_URL=

# مهلت‌ها بر حسب ثانیه. پیش‌فرض‌ها برای پیوند کند و ناپایدار
# تنظیم شده‌اند؛ اگر پیوندتان تندروست می‌توانید کمترشان کنید.
CONNECT_TIMEOUT=20
READ_TIMEOUT=60
WRITE_TIMEOUT=120
POOL_TIMEOUT=20
CONNECTION_POOL_SIZE=32

# چند بار یک کار شبکه‌ای، پس از شکست گذرا، دوباره آزموده شود
NETWORK_RETRIES=3
